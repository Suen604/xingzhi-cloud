@@ -0,0 +1,134 @@
+import {
+  Button,
+  Stack,
+  Table,
+  TableBody,
+  TableCell,
+  TableContainer,
+  TableHead,
+  TableRow,
+  TextField,
+  Typography,
+} from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { send } from "../../../api/request";
+import { useAppDispatch } from "../../../redux/hooks";
+
+export default function ExtensionRecords({ kind }: { kind: "audit" | "orders" | "reports" }) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [page, setPage] = useState(1);
+  const [result, setResult] = useState<{ items: any[]; total: number }>({ items: [], total: 0 });
+  const [generation, setGeneration] = useState(0);
+  const [filter, setFilter] = useState("");
+  useEffect(() => {
+    dispatch(send(`/admin/extensions/${kind}`, { params: { page, action: filter } }))
+      .then(setResult)
+      .catch(() => {});
+  }, [dispatch, kind, page, generation, filter]);
+  const keys =
+    kind === "audit"
+      ? ["created_at", "actor_id", "action", "resource", "status", "ip"]
+      : kind === "orders"
+        ? ["created_at", "number", "user_id", "product_name", "amount", "provider", "status"]
+        : ["created_at", "share_id", "reporter_id", "reason", "status", "resolution"];
+  return (
+    <Stack spacing={2}>
+      <Typography variant="h6">
+        {kind === "audit"
+          ? zh
+            ? "审计日志"
+            : "Audit log"
+          : kind === "orders"
+            ? zh
+              ? "订单"
+              : "Orders"
+            : zh
+              ? "滥用举报"
+              : "Abuse reports"}
+      </Typography>
+      {kind === "audit" && (
+        <TextField
+          size="small"
+          label={zh ? "按操作筛选" : "Filter actions"}
+          value={filter}
+          onChange={(e) => {
+            setFilter(e.target.value);
+            setPage(1);
+          }}
+        />
+      )}
+      <TableContainer>
+        <Table size="small">
+          <TableHead>
+            <TableRow>
+              {keys.map((key) => (
+                <TableCell key={key}>{key}</TableCell>
+              ))}
+              {kind === "reports" && <TableCell>{zh ? "处理" : "Actions"}</TableCell>}
+            </TableRow>
+          </TableHead>
+          <TableBody>
+            {result.items.map((row) => (
+              <TableRow key={row.id}>
+                {keys.map((key) => (
+                  <TableCell key={key}>{String(row[key] ?? "")}</TableCell>
+                ))}
+                {kind === "reports" && (
+                  <TableCell>
+                    <Button
+                      disabled={row.status !== "open"}
+                      onClick={async () => {
+                        await dispatch(
+                          send(`/admin/extensions/reports/${row.id}`, {
+                            method: "PATCH",
+                            data: {
+                              status: "resolved",
+                              disable_share: true,
+                              resolution: zh ? "已禁用分享" : "Share disabled",
+                            },
+                          }),
+                        );
+                        setGeneration((n) => n + 1);
+                      }}
+                    >
+                      {zh ? "禁用分享" : "Disable share"}
+                    </Button>
+                    <Button
+                      disabled={row.status !== "open"}
+                      onClick={async () => {
+                        await dispatch(
+                          send(`/admin/extensions/reports/${row.id}`, {
+                            method: "PATCH",
+                            data: { status: "dismissed" },
+                          }),
+                        );
+                        setGeneration((n) => n + 1);
+                      }}
+                    >
+                      {zh ? "忽略" : "Dismiss"}
+                    </Button>
+                  </TableCell>
+                )}
+              </TableRow>
+            ))}
+          </TableBody>
+        </Table>
+      </TableContainer>
+      <Stack direction="row" spacing={2}>
+        <Button onClick={() => setPage((p) => p - 1)} disabled={page === 1}>
+          {zh ? "上一页" : "Previous"}
+        </Button>
+        <Typography>
+          {page} / {Math.max(1, Math.ceil(result.total / 20))}
+        </Typography>
+        <Button onClick={() => setPage((p) => p + 1)} disabled={page * 20 >= result.total}>
+          {zh ? "下一页" : "Next"}
+        </Button>
+        <Button onClick={() => setGeneration((n) => n + 1)}>{zh ? "刷新" : "Refresh"}</Button>
+      </Stack>
+    </Stack>
+  );
+}
