+export function sharePrice(setting: ShareSetting): number {
+  if (!setting.paid) return 0;
+  const raw = setting.price_yuan ?? "";
+  if (!/^(0|[1-9]\d{0,6})(\.\d{1,2})?$/.test(raw)) return NaN;
+  const [whole, fraction = ""] = raw.split(".");
+  const value = Number(whole) * 100 + Number(fraction.padEnd(2, "0"));
+  return value >= 1 && value <= 100000000 ? value : NaN;
+}
