+++ b/src/component/Pages/Shop.tsx
@@ -0,0 +1,143 @@
+import {
+  Button,
+  Card,
+  CardContent,
+  Container,
+  Dialog,
+  DialogContent,
+  DialogTitle,
+  Stack,
+  TextField,
+  Typography,
+} from "@mui/material";
+import { QRCodeSVG } from "qrcode.react";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { send } from "../../api/request";
+import { useAppDispatch } from "../../redux/hooks";
+import StoragePolicySelector from "./StoragePolicySelector";
+
+export default function Shop() {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [config, setConfig] = useState<any>({ products: [] });
+  const [orders, setOrders] = useState<any[]>([]);
+  const [checkout, setCheckout] = useState<any>();
+  const [code, setCode] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+  const load = () => dispatch(send<{ items: any[] }>("/commerce/orders")).then((result) => setOrders(result.items));
+  useEffect(() => {
+    dispatch(send("/extensions/public")).then(setConfig);
+    load();
+  }, [dispatch]);
+  useEffect(() => {
+    if (!checkout) return;
+    const timer = window.setInterval(async () => {
+      const result = await dispatch(send<{ items: any[] }>("/commerce/orders"));
+      setOrders(result.items);
+      if (result.items.some((order) => order.number === checkout.order.number && order.status === "fulfilled")) {
+        setCheckout(undefined);
+        setMessage(zh ? "支付成功，权益已到账" : "Payment received and benefits applied");
+      }
+    }, 4000);
+    return () => window.clearInterval(timer);
+  }, [checkout, dispatch, zh]);
+  const buy = async (product: string, provider: string) => {
+    setBusy(true);
+    try {
+      const result = await dispatch(send<any>("/commerce/orders", { method: "POST", data: { product, provider } }));
+      setCheckout(result);
+      await load();
+    } finally {
+      setBusy(false);
+    }
+  };
+  return (
+    <Container sx={{ py: 4 }}>
+      <Stack spacing={3}>
+        <Typography variant="h4">{zh ? "商店与兑换" : "Shop and gift codes"}</Typography>
+        <StoragePolicySelector />
+        <Stack direction="row" spacing={2}>
+          {["qq", "logto"]
+            .filter((provider) => config[provider])
+            .map((provider) => (
+              <Button
+                key={provider}
+                onClick={async () => {
+                  const result = await dispatch(
+                    send<{ url: string }>(`/sso/${provider}/start?link=1`, { method: "POST" }),
+                  );
+                  window.location.assign(result.url);
+                }}
+              >
+                {zh ? "绑定" : "Link"} {provider === "qq" ? "QQ" : "Logto"}
+              </Button>
+            ))}
+        </Stack>
+        {config.products?.map((p: any) => (
+          <Card key={p.id}>
+            <CardContent>
+              <Stack spacing={2}>
+                <Typography variant="h6">{p.name}</Typography>
+                <Typography>¥{(p.amount / 100).toFixed(2)}</Typography>
+                <Stack direction="row" spacing={2}>
+                  {config.alipay && (
+                    <Button disabled={busy} onClick={() => buy(p.id, "alipay")}>
+                      {zh ? "支付宝" : "Alipay"}
+                    </Button>
+                  )}
+                  {config.wechat && (
+                    <Button disabled={busy} onClick={() => buy(p.id, "wechat")}>
+                      {zh ? "微信支付" : "WeChat Pay"}
+                    </Button>
+                  )}
+                </Stack>
+              </Stack>
+            </CardContent>
+          </Card>
+        ))}
+        <TextField label={zh ? "兑换码" : "Gift code"} value={code} onChange={(e) => setCode(e.target.value)} />
+        <Button
+          disabled={busy || !code}
+          onClick={async () => {
+            setBusy(true);
+            try {
+              await dispatch(send("/commerce/redeem", { method: "POST", data: { code } }));
+              setCode("");
+              setMessage(zh ? "兑换成功" : "Gift code redeemed");
+            } finally {
+              setBusy(false);
+            }
+          }}
+        >
+          {zh ? "兑换" : "Redeem"}
+        </Button>
+        <Typography>{message}</Typography>
+        <Typography variant="h6">{zh ? "最近订单" : "Recent orders"}</Typography>
+        {orders.map((order) => (
+          <Typography key={order.id}>
+            {order.product_name} · ¥{(order.amount / 100).toFixed(2)} · {order.status}
+          </Typography>
+        ))}
+        <Button onClick={load}>{zh ? "刷新订单" : "Refresh orders"}</Button>
+      </Stack>
+      <Dialog open={!!checkout} onClose={() => setCheckout(undefined)}>
+        <DialogTitle>{zh ? "完成支付" : "Complete payment"}</DialogTitle>
+        <DialogContent>
+          {checkout?.url?.startsWith("weixin://") ? (
+            <QRCodeSVG value={checkout.url} size={240} />
+          ) : (
+            <Button variant="contained" href={checkout?.url} target="_blank" rel="noopener noreferrer">
+              {zh ? "打开支付宝收银台" : "Open Alipay checkout"}
+            </Button>
+          )}
+          <Typography sx={{ mt: 2 }}>
+            {zh ? "支付完成后，此页面将自动更新。" : "This page updates after payment confirmation."}
+          </Typography>
+        </DialogContent>
+      </Dialog>
+    </Container>
+  );
+}
diff --git a/src/component/Pages/StoragePolicySelector.tsx b/src/component/Pages/StoragePolicySelector.tsx
