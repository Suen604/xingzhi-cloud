@@ -0,0 +1,276 @@
+import { Box, Button, Checkbox, Divider, FormControlLabel, Stack, TextField, Typography } from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { send } from "../../../api/request";
+import { useAppDispatch } from "../../../redux/hooks";
+import ExtensionRecords from "./ExtensionRecords";
+
+export default function ExtensionSettings({ section }: { section: "sso" | "commerce" | "audit" }) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const l = (cn: string, en: string) => (zh ? cn : en);
+  const [config, setConfig] = useState<any>();
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+  useEffect(() => {
+    dispatch(send("/admin/extensions/config"))
+      .then(setConfig)
+      .catch(() => {});
+  }, [dispatch]);
+  if (!config) return <Typography>{l("正在加载…", "Loading…")}</Typography>;
+  const change = (provider: string, key: string, value: any) =>
+    setConfig((prev: any) => ({ ...prev, [provider]: { ...prev[provider], [key]: value } }));
+  const field = (provider: string, key: string, label: string, secret = false, multiline = false) => (
+    <TextField
+      key={key}
+      size="small"
+      label={label}
+      type={secret && !multiline ? "password" : "text"}
+      multiline={multiline}
+      minRows={multiline ? 3 : undefined}
+      autoComplete="off"
+      value={config[provider]?.[key] ?? ""}
+      onChange={(e) => change(provider, key, e.target.value)}
+    />
+  );
+  const save = async () => {
+    setBusy(true);
+    setMessage("");
+    try {
+      await dispatch(send("/admin/extensions/config", { method: "PUT", data: config }));
+      setMessage(l("已保存", "Saved"));
+    } finally {
+      setBusy(false);
+    }
+  };
+  return (
+    <Stack spacing={3} sx={{ maxWidth: 1000 }}>
+      {section === "sso" &&
+        ["qq", "logto"].map((provider) => (
+          <Stack spacing={2} key={provider}>
+            <Typography variant="h6">{provider === "qq" ? "QQ" : "Logto / OpenID Connect"}</Typography>
+            <FormControlLabel
+              control={
+                <Checkbox
+                  checked={!!config[provider]?.enabled}
+                  onChange={(e) => change(provider, "enabled", e.target.checked)}
+                />
+              }
+              label={l("启用登录", "Enable sign-in")}
+            />
+            {field(provider, "client_id", "Client ID / App ID")}
+            {field(provider, "client_secret", "Client secret / App key", true)}
+            {provider === "logto" && field(provider, "issuer", l("签发者地址", "Issuer URL"))}
+            <TextField
+              size="small"
+              label={l("回调地址", "Callback URL")}
+              value={`${window.location.origin}/api/v4/sso/${provider}/callback`}
+              slotProps={{ input: { readOnly: true } }}
+            />
+            <FormControlLabel
+              control={
+                <Checkbox
+                  checked={!!config[provider]?.allow_registration}
+                  onChange={(e) => change(provider, "allow_registration", e.target.checked)}
+                />
+              }
+              label={l(
+                "允许创建新账户（同时遵循全站注册开关）",
+                "Allow new accounts when site registration is enabled",
+              )}
+            />
+          </Stack>
+        ))}
+      {section === "commerce" && (
+        <>
+          {["alipay", "wechat"].map((provider) => (
+            <Stack spacing={2} key={provider}>
+              <Typography variant="h6">
+                {provider === "alipay" ? l("支付宝", "Alipay") : l("微信支付", "WeChat Pay")}
+              </Typography>
+              {field(provider, "app_id", "App ID")}
+              {field(
+                provider,
+                "merchant_id",
+                provider === "wechat" ? l("商户号", "Merchant ID") : l("卖家 ID", "Seller ID"),
+              )}
+              {field(provider, "private_key", l("商户私钥（PEM）", "Merchant private key (PEM)"), true, true)}
+              {field(
+                provider,
+                "public_key",
+                provider === "wechat"
+                  ? l("微信支付平台公钥或证书（PEM）", "WeChat platform public key or certificate (PEM)")
+                  : l("支付宝公钥（PEM）", "Alipay public key (PEM)"),
+                false,
+                true,
+              )}
+              {provider === "wechat" && (
+                <>
+                  {field(provider, "serial", l("商户证书序列号", "Merchant certificate serial"))}
+                  {field(
+                    provider,
+                    "platform_serial",
+                    l("平台公钥 ID 或证书序列号", "Platform key ID or certificate serial"),
+                  )}
+                  {field(provider, "api_key", "API v3 key", true)}
+                </>
+              )}
+              {provider === "alipay" && (
+                <FormControlLabel
+                  control={
+                    <Checkbox
+                      checked={!!config.alipay?.sandbox}
+                      onChange={(e) => change(provider, "sandbox", e.target.checked)}
+                    />
+                  }
+                  label={l("沙箱环境", "Sandbox")}
+                />
+              )}
+            </Stack>
+          ))}
+          <Divider />
+          <Typography variant="h6">
+            {l("商品（永久容量或用户组权益）", "Products (permanent storage or group benefits)")}
+          </Typography>
+          {(config.products ?? []).map((product: any, index: number) => (
+            <Stack key={index} spacing={1}>
+              {[
+                ["id", l("商品 ID", "Product ID")],
+                ["name", l("名称", "Name")],
+                ["amount", l("价格（人民币分）", "Price (CNY fen)")],
+                ["storage_bytes", l("永久容量（字节）", "Permanent storage (bytes)")],
+                ["group_id", l("用户组 ID（0 表示不更改）", "Group ID (0 keeps current group)")],
+              ].map(([key, label]) => (
+                <TextField
+                  key={key}
+                  size="small"
+                  label={label}
+                  type={["amount", "storage_bytes", "group_id"].includes(key) ? "number" : "text"}
+                  value={product[key] ?? ""}
+                  onChange={(e) =>
+                    setConfig((prev: any) => ({
+                      ...prev,
+                      products: prev.products.map((p: any, i: number) =>
+                        i === index
+                          ? {
+                              ...p,
+                              [key]: ["amount", "storage_bytes", "group_id"].includes(key)
+                                ? Number(e.target.value)
+                                : e.target.value,
+                            }
+                          : p,
+                      ),
+                    }))
+                  }
+                />
+              ))}
+              <Button
+                onClick={() =>
+                  setConfig((prev: any) => ({
+                    ...prev,
+                    products: prev.products.filter((_: any, i: number) => i !== index),
+                  }))
+                }
+              >
+                {l("删除商品", "Remove product")}
+              </Button>
+            </Stack>
+          ))}
+          <Button
+            onClick={() =>
+              setConfig((prev: any) => ({
+                ...prev,
+                products: [...(prev.products ?? []), { id: "", name: "", amount: 100, storage_bytes: 0, group_id: 0 }],
+              }))
+            }
+          >
+            {l("添加商品", "Add product")}
+          </Button>
+          <GiftCodeGenerator products={config.products ?? []} />
+        </>
+      )}
+      {section === "audit" && (
+        <>
+          <FormControlLabel
+            control={
+              <Checkbox checked={!!config.audit} onChange={(e) => setConfig({ ...config, audit: e.target.checked })} />
+            }
+            label={l("记录操作审计日志", "Record audit metadata")}
+          />
+          <ExtensionRecords kind="audit" />
+        </>
+      )}
+      <Box>
+        <Button variant="contained" onClick={save} disabled={busy}>
+          {l("保存", "Save")}
+        </Button>{" "}
+        <Typography component="span">{message}</Typography>
+      </Box>
+    </Stack>
+  );
+}
+
+function GiftCodeGenerator({ products }: { products: any[] }) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [product, setProduct] = useState("");
+  const [count, setCount] = useState(1);
+  const [days, setDays] = useState(30);
+  const [codes, setCodes] = useState<string[]>([]);
+  return (
+    <Stack spacing={2}>
+      <Typography variant="h6">{zh ? "兑换码" : "Gift codes"}</Typography>
+      <TextField
+        select
+        SelectProps={{ native: true }}
+        label={zh ? "已保存的商品" : "Saved product"}
+        value={product}
+        onChange={(e) => setProduct(e.target.value)}
+      >
+        <option value="" />
+        {products.map((p) => (
+          <option key={p.id} value={p.id}>
+            {p.name}
+          </option>
+        ))}
+      </TextField>
+      <TextField
+        type="number"
+        label={zh ? "数量（1–100）" : "Count (1–100)"}
+        value={count}
+        onChange={(e) => setCount(Number(e.target.value))}
+      />
+      <TextField
+        type="number"
+        label={zh ? "兑换有效期（天）" : "Redemption validity (days)"}
+        value={days}
+        onChange={(e) => setDays(Number(e.target.value))}
+      />
+      <Button
+        disabled={!product}
+        onClick={async () => {
+          const result = await dispatch(
+            send<{ codes: string[] }>("/admin/extensions/giftcodes", {
+              method: "POST",
+              data: { product, count, days },
+            }),
+          );
+          setCodes(result.codes);
+        }}
+      >
+        {zh ? "生成兑换码" : "Generate gift codes"}
+      </Button>
+      {!!codes.length && (
+        <TextField
+          multiline
+          minRows={3}
+          label={zh ? "请保存，完整兑换码仅显示一次" : "Save these codes; shown only once"}
+          value={codes.join("\n")}
+          slotProps={{ input: { readOnly: true } }}
+        />
+      )}
+    </Stack>
+  );
+}
diff --git a/src/component/Admin/Group/EditGroup/AllowedPolicySelection.tsx b/src/component/Admin/Group/EditGroup/AllowedPolicySelection.tsx
new file mode 100644
