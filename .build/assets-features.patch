@@ -0,0 +1,53 @@
+import { Checkbox, FormControlLabel, Stack, Typography } from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { getStoragePolicyList } from "../../../../api/api";
+import { StoragePolicy } from "../../../../api/dashboard";
+import { useAppDispatch } from "../../../../redux/hooks";
+
+export default function AllowedPolicySelection({
+  value,
+  onChange,
+  physicalOnly = false,
+}: {
+  value: number[];
+  onChange: (ids: number[]) => void;
+  physicalOnly?: boolean;
+}) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const [policies, setPolicies] = useState<StoragePolicy[]>([]);
+  useEffect(() => {
+    dispatch(getStoragePolicyList({ page: 1, page_size: 1000, order_by: "id", order_direction: "asc" })).then(
+      (result) => setPolicies(result.policies.filter((policy) => !physicalOnly || policy.type !== "load_balance")),
+    );
+  }, [dispatch, physicalOnly]);
+  return (
+    <Stack>
+      <Typography variant="body2">
+        {physicalOnly
+          ? i18n.language.startsWith("zh")
+            ? "负载均衡目标策略"
+            : "Load balancing destinations"
+          : i18n.language.startsWith("zh")
+            ? "用户可选的其他存储策略"
+            : "Additional policies users may select"}
+      </Typography>
+      {policies.map((policy) => (
+        <FormControlLabel
+          key={policy.id}
+          label={policy.name}
+          control={
+            <Checkbox
+              size="small"
+              checked={value.includes(policy.id)}
+              onChange={(e) =>
+                onChange(e.target.checked ? [...value, policy.id] : value.filter((id) => id !== policy.id))
+              }
+            />
+          }
+        />
+      ))}
+    </Stack>
+  );
+}
diff --git a/src/component/Admin/StoragePolicy/Wizards/LoadBalanceWizard.tsx b/src/component/Admin/StoragePolicy/Wizards/LoadBalanceWizard.tsx
new file mode 100644
index 0000000..c300ac4
--- /dev/null
+++ b/src/component/Admin/StoragePolicy/Wizards/LoadBalanceWizard.tsx
@@ -0,0 +1,61 @@
+import { Button, Checkbox, FormControlLabel, Stack, TextField, Typography } from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { getStoragePolicyList } from "../../../../api/api";
+import { StoragePolicy } from "../../../../api/dashboard";
+import { PolicyType } from "../../../../api/explorer";
+import { useAppDispatch } from "../../../../redux/hooks";
+import { AddWizardProps } from "../AddWizardDialog";
+
+export default function LoadBalanceWizard({ onSubmit }: AddWizardProps) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [name, setName] = useState("");
+  const [policies, setPolicies] = useState<StoragePolicy[]>([]);
+  const [selected, setSelected] = useState<number[]>([]);
+  useEffect(() => {
+    dispatch(getStoragePolicyList({ page: 1, page_size: 1000, order_by: "id", order_direction: "asc" })).then(
+      (result) => setPolicies(result.policies.filter((p) => p.type !== PolicyType.load_balance)),
+    );
+  }, [dispatch]);
+  return (
+    <Stack spacing={2}>
+      <TextField label={zh ? "名称" : "Name"} value={name} onChange={(e) => setName(e.target.value)} />
+      <Typography>
+        {zh
+          ? "新文件随机分配到所选策略；现有文件始终从原位置读取。"
+          : "New files are distributed across selected policies; existing files keep their original location."}
+      </Typography>
+      {policies.map((policy) => (
+        <FormControlLabel
+          key={policy.id}
+          label={policy.name}
+          control={
+            <Checkbox
+              checked={selected.includes(policy.id)}
+              onChange={(e) =>
+                setSelected((prev) => (e.target.checked ? [...prev, policy.id] : prev.filter((id) => id !== policy.id)))
+              }
+            />
+          }
+        />
+      ))}
+      <Button
+        variant="contained"
+        disabled={!name || !selected.length}
+        onClick={() =>
+          onSubmit({
+            name,
+            type: PolicyType.load_balance,
+            settings: { balanced_policies: selected },
+            dir_name_rule: "{uid}/{path}",
+            file_name_rule: "{name}",
+          } as StoragePolicy)
+        }
+      >
+        {zh ? "创建" : "Create"}
+      </Button>
+    </Stack>
+  );
+}
diff --git a/src/component/FileManager/Explorer/PaidShareAccess.tsx b/src/component/FileManager/Explorer/PaidShareAccess.tsx
new file mode 100644
index 0000000..8e27155
--- /dev/null
+++ b/src/component/FileManager/Explorer/PaidShareAccess.tsx
@@ -0,0 +1,222 @@
+import { Alert, Button, CircularProgress, Stack, Typography } from "@mui/material";
+import { QRCodeSVG } from "qrcode.react";
+import { useContext, useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { useNavigate } from "react-router-dom";
+import { getShareInfo } from "../../../api/api";
+import { Share } from "../../../api/explorer";
+import { send } from "../../../api/request";
+import { useAppDispatch, useAppSelector } from "../../../redux/hooks";
+import SessionManager from "../../../session";
+import CrUri from "../../../util/uri";
+import { FmIndexContext } from "../FmIndexContext";
+
+interface Checkout {
+  order: { number: string; amount: number; expires_at: string; provider: string };
+  url: string;
+}
+
+export default function PaidShareAccess() {
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const dispatch = useAppDispatch();
+  const navigate = useNavigate();
+  const index = useContext(FmIndexContext);
+  const path = useAppSelector((state) => state.fileManager[index].path);
+  const [info, setInfo] = useState<Share>();
+  const [providers, setProviders] = useState<{ alipay?: boolean; wechat?: boolean }>({});
+  const [checkout, setCheckout] = useState<Checkout>();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [expired, setExpired] = useState(false);
+  const signedIn = !!SessionManager.currentLoginOrNull();
+
+  useEffect(() => {
+    let active = true;
+    setInfo(undefined);
+    setCheckout(undefined);
+    setError("");
+    if (!path) return;
+    const uri = new CrUri(path);
+    Promise.all([
+      dispatch(getShareInfo(uri.id(), uri.password())),
+      dispatch(send<{ alipay?: boolean; wechat?: boolean }>("/extensions/public")),
+    ])
+      .then(([share, config]) => {
+        if (active) {
+          setInfo(share);
+          setProviders(config);
+        }
+      })
+      .catch((e) => {
+        if (active) setError(String(e.message ?? e));
+      });
+    return () => {
+      active = false;
+    };
+  }, [path, dispatch]);
+
+  useEffect(() => {
+    if (!checkout || !path) return;
+    let active = true;
+    let pending = false;
+    const timer = window.setInterval(async () => {
+      if (pending) return;
+      pending = true;
+      try {
+        const order = await dispatch(
+          send<{ status: string }>(`/commerce/orders/${encodeURIComponent(checkout.order.number)}`),
+        );
+        if (!active) return;
+        if (order.status === "fulfilled") {
+          window.clearInterval(timer);
+          const uri = new CrUri(path);
+          const share = await dispatch(getShareInfo(uri.id(), uri.password()));
+          if (!active) return;
+          if (share.purchased) window.location.reload();
+          else
+            setError(
+              zh
+                ? "款项已到账，但分享已变更。请联系站点管理员并提供订单号。"
+                : "Payment received, but the share has changed. Contact the site administrator with your order number.",
+            );
+        } else if (order.status === "cancelled" || Date.now() > Date.parse(checkout.order.expires_at)) {
+          window.clearInterval(timer);
+          setExpired(true);
+        }
+      } catch (e: any) {
+        if (active) setError(String(e.message ?? e));
+      } finally {
+        pending = false;
+      }
+    }, 4000);
+    return () => {
+      active = false;
+      window.clearInterval(timer);
+    };
+  }, [checkout, path, dispatch, zh]);
+
+  const buy = async (provider: string) => {
+    if (!path || !info) return;
+    setBusy(true);
+    setError("");
+    setExpired(false);
+    const uri = new CrUri(path);
+    try {
+      const result = await dispatch(
+        send<Checkout>("/commerce/share-orders", {
+          method: "POST",
+          data: { share_id: info.id, password: uri.password(), provider },
+        }),
+      );
+      setCheckout(result);
+    } catch (e: any) {
+      setError(String(e.message ?? e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <Stack
+      spacing={2}
+      alignItems="center"
+      sx={{ width: "100%", maxWidth: 540, maxHeight: "100%", overflow: "auto", p: 1 }}
+      onClick={(e) => e.stopPropagation()}
+      onMouseDown={(e) => e.stopPropagation()}
+    >
+      <Typography variant="h5">{zh ? "付款解锁分享" : "Unlock this share"}</Typography>
+      {info && (
+        <>
+          <Typography sx={{ overflowWrap: "anywhere" }}>{info.name}</Typography>
+          <Typography variant="h4">¥{(info.price / 100).toFixed(2)}</Typography>
+        </>
+      )}
+      {!info && !error && <CircularProgress size={24} />}
+      <Typography variant="body2" color="text.secondary">
+        {zh
+          ? "登录后一次付款，解锁该分享有效期内的内容。密码、有效期和下载次数限制仍然适用；款项由站点商户收取。"
+          : "Sign in and pay once for access while this share remains valid. Password, expiration and download limits still apply. The site merchant collects payment."}
+      </Typography>
+      {error && <Alert severity="error">{error}</Alert>}
+      {!signedIn ? (
+        <Button
+          variant="contained"
+          onClick={() =>
+            navigate("/session?redirect=" + encodeURIComponent(window.location.pathname + window.location.search))
+          }
+        >
+          {zh ? "登录后购买" : "Sign in to purchase"}
+        </Button>
+      ) : info?.purchased ? (
+        <Button variant="contained" onClick={() => window.location.reload()}>
+          {zh ? "已购买，刷新进入" : "Purchased — refresh to open"}
+        </Button>
+      ) : (
+        <>
+          {info && !providers.alipay && !providers.wechat && (
+            <Alert severity="warning">
+              {zh
+                ? "站点尚未配置支付渠道，请联系管理员。"
+                : "No payment provider is configured. Contact the administrator."}
+            </Alert>
+          )}
+          <Stack direction="row" spacing={1}>
+            {providers.alipay && (
+              <Button
+                disabled={busy || !info || (!!checkout && !expired)}
+                variant="contained"
+                onClick={() => buy("alipay")}
+              >
+                {zh ? "支付宝" : "Alipay"}
+              </Button>
+            )}
+            {providers.wechat && (
+              <Button
+                disabled={busy || !info || (!!checkout && !expired)}
+                variant="contained"
+                onClick={() => buy("wechat")}
+              >
+                {zh ? "微信支付" : "WeChat Pay"}
+              </Button>
+            )}
+          </Stack>
+        </>
+      )}
+      {checkout && (
+        <>
+          <Typography variant="body2">
+            {zh ? "订单金额" : "Order amount"} ¥{(checkout.order.amount / 100).toFixed(2)}
+          </Typography>
+          <Typography variant="caption" sx={{ overflowWrap: "anywhere" }}>
+            {zh ? "订单号：" : "Order: "}
+            {checkout.order.number}
+          </Typography>
+          {!expired &&
+            (checkout.order.provider === "wechat" ? (
+              <>
+                <QRCodeSVG value={checkout.url} size={200} />
+                <Typography variant="body2">
+                  {zh ? "使用微信扫码支付，到账后自动解锁" : "Scan with WeChat; access unlocks after payment"}
+                </Typography>
+              </>
+            ) : (
+              <Button component="a" href={checkout.url} target="_blank" rel="noopener noreferrer" variant="outlined">
+                {zh ? "打开支付宝付款" : "Open Alipay checkout"}
+              </Button>
+            ))}
+          {expired && (
+            <Alert severity="warning">
+              {zh
+                ? "订单等待时间已结束。如已付款，请先检查支付结果，勿重复付款。"
+                : "The checkout has expired. If you paid, check the result before paying again."}
+            </Alert>
+          )}
+          <Button onClick={() => window.location.reload()}>
+            {zh ? "已付款，检查解锁状态" : "Paid — check access"}
+          </Button>
+        </>
+      )}
+    </Stack>
+  );
+}
diff --git a/src/component/FileManager/Sidebar/Collaborators.tsx b/src/component/FileManager/Sidebar/Collaborators.tsx
new file mode 100644
index 0000000..0828aee
--- /dev/null
+++ b/src/component/FileManager/Sidebar/Collaborators.tsx
@@ -0,0 +1,226 @@
+import {
+  Alert,
+  Autocomplete,
+  Button,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  MenuItem,
+  Stack,
+  TextField,
+  Typography,
+} from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { getSearchUser } from "../../../api/api";
+import { FileResponse, Metadata } from "../../../api/explorer";
+import { send } from "../../../api/request";
+import { User } from "../../../api/user";
+import { useAppDispatch } from "../../../redux/hooks";
+import SessionManager from "../../../session";
+import CrUri, { Filesystem } from "../../../util/uri";
+
+interface Member {
+  user_id: string;
+  nickname: string;
+  role: "viewer" | "editor";
+  inherited: boolean;
+  source_id: string;
+  source_name: string;
+}
+
+export default function Collaborators({ file }: { file: FileResponse }) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [open, setOpen] = useState(false);
+  const [members, setMembers] = useState<Member[]>([]);
+  const [keyword, setKeyword] = useState("");
+  const [options, setOptions] = useState<User[]>([]);
+  const [selected, setSelected] = useState<User | null>(null);
+  const [role, setRole] = useState<"viewer" | "editor">("viewer");
+  const [busy, setBusy] = useState(false);
+  const [ready, setReady] = useState(false);
+  const [error, setError] = useState("");
+  const uri = new CrUri(file.path);
+  const available =
+    file.owned &&
+    uri.fs() === Filesystem.my &&
+    !uri.is_root() &&
+    !file.metadata?.[Metadata.share_redirect] &&
+    !file.metadata?.[Metadata.restore_uri];
+
+  const load = async () => {
+    const result = await dispatch(send<{ items: Member[] }>("/file/permissions", { params: { uri: file.path } }));
+    setMembers(result.items);
+    setReady(true);
+  };
+
+  useEffect(() => {
+    setOpen(false);
+    setReady(false);
+    setSelected(null);
+    setOptions([]);
+    setKeyword("");
+  }, [file.path]);
+
+  useEffect(() => {
+    if (!open) return;
+    setBusy(true);
+    setError("");
+    setReady(false);
+    load()
+      .catch((e) => setError(String(e.message ?? e)))
+      .finally(() => setBusy(false));
+  }, [open, file.path]);
+
+  useEffect(() => {
+    setOptions([]);
+    if (!open || keyword.trim().length < 2) return;
+    let active = true;
+    const timer = window.setTimeout(() => {
+      dispatch(getSearchUser(keyword.trim()))
+        .then((users) => {
+          if (active) setOptions(users.filter((u) => u.id !== SessionManager.currentUser()?.id));
+        })
+        .catch(() => {});
+    }, 300);
+    return () => {
+      active = false;
+      window.clearTimeout(timer);
+    };
+  }, [keyword, open, dispatch]);
+
+  const save = async (userId: string, nextRole?: string) => {
+    setBusy(true);
+    setError("");
+    try {
+      await dispatch(
+        send("/file/permissions", {
+          method: nextRole ? "PUT" : "DELETE",
+          data: { uri: file.path, user_id: userId, role: nextRole },
+        }),
+      );
+      await load();
+      setSelected(null);
+      setKeyword("");
+    } catch (e: any) {
+      setError(String(e.message ?? e));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  if (!available) return null;
+  const roleLabel = (value: string) => (value === "editor" ? (zh ? "可编辑" : "Editor") : zh ? "只读" : "Viewer");
+  return (
+    <>
+      <Button variant="outlined" onClick={() => setOpen(true)}>
+        {zh ? "权限与协作" : "Permissions & collaboration"}
+      </Button>
+      <Dialog
+        open={open}
+        onClose={() => {
+          if (!busy) setOpen(false);
+        }}
+        fullWidth
+        maxWidth="sm"
+      >
+        <DialogTitle>
+          {zh ? "权限与协作" : "Permissions & collaboration"} · {file.name}
+        </DialogTitle>
+        <DialogContent>
+          <Stack spacing={2} sx={{ pt: 1 }}>
+            <Alert severity="info">
+              {zh
+                ? "只读成员可以浏览和下载。可编辑成员还可以上传、修改、重命名、移动和移入回收站。文件夹权限由子项继承，多个授权取最高权限；删除直接授权不会取消从上级继承的权限。上传占用所有者容量，只有所有者可以管理成员。"
+                : "Viewers can browse and download. Editors can also upload, modify, rename, move and send items to trash. Folder grants apply to descendants; the highest grant wins. Removing a direct grant keeps inherited access. Uploads use the owner's quota. Only the owner manages members."}
+            </Alert>
+            {error && <Alert severity="error">{error}</Alert>}
+            <Typography variant="body2">
+              {zh ? "你是所有者，拥有完整控制权。" : "You are the owner and have full control."}
+            </Typography>
+            {ready && members.length === 0 && (
+              <Typography color="text.secondary">{zh ? "尚未添加协作成员" : "No collaborators yet"}</Typography>
+            )}
+            {members.map((member) => (
+              <Stack key={`${member.source_id}:${member.user_id}`} direction="row" spacing={1} alignItems="center">
+                <Stack sx={{ flex: 1, minWidth: 0 }}>
+                  <Typography sx={{ overflowWrap: "anywhere" }}>{member.nickname}</Typography>
+                  {member.inherited && (
+                    <Typography variant="caption" color="text.secondary">
+                      {zh
+                        ? `继承自「${member.source_name}」，请在上级管理`
+                        : `Inherited from “${member.source_name}”; manage on the parent`}
+                    </Typography>
+                  )}
+                </Stack>
+                <TextField
+                  select
+                  size="small"
+                  value={member.role}
+                  disabled={busy || member.inherited}
+                  label={zh ? "权限" : "Role"}
+                  sx={{ minWidth: 110 }}
+                  onChange={(e) => save(member.user_id, e.target.value)}
+                >
+                  <MenuItem value="viewer">{roleLabel("viewer")}</MenuItem>
+                  <MenuItem value="editor">{roleLabel("editor")}</MenuItem>
+                </TextField>
+                {!member.inherited && (
+                  <Button color="error" disabled={busy} onClick={() => save(member.user_id)}>
+                    {zh ? "撤销" : "Revoke"}
+                  </Button>
+                )}
+              </Stack>
+            ))}
+            <Autocomplete
+              options={options}
+              value={selected}
+              disabled={busy || !ready}
+              filterOptions={(items) => items}
+              getOptionLabel={(u) => u.nickname}
+              isOptionEqualToValue={(a, b) => a.id === b.id}
+              onInputChange={(_e, value, reason) => {
+                if (reason === "input") setKeyword(value);
+              }}
+              onChange={(_e, value) => setSelected(value)}
+              renderInput={(params) => (
+                <TextField
+                  {...params}
+                  label={zh ? "搜索注册用户（至少两个字符）" : "Find a registered user (2+ characters)"}
+                />
+              )}
+            />
+            <Stack direction="row" spacing={1}>
+              <TextField
+                select
+                label={zh ? "权限" : "Role"}
+                value={role}
+                disabled={busy}
+                sx={{ minWidth: 140 }}
+                onChange={(e) => setRole(e.target.value as "viewer" | "editor")}
+              >
+                <MenuItem value="viewer">{roleLabel("viewer")}</MenuItem>
+                <MenuItem value="editor">{roleLabel("editor")}</MenuItem>
+              </TextField>
+              <Button
+                variant="contained"
+                disabled={busy || !ready || !selected}
+                onClick={() => selected && save(selected.id, role)}
+              >
+                {zh ? "添加或更新成员" : "Add or update member"}
+              </Button>
+            </Stack>
+          </Stack>
+        </DialogContent>
+        <DialogActions>
+          <Button disabled={busy} onClick={() => setOpen(false)}>
+            {zh ? "关闭" : "Close"}
+          </Button>
+        </DialogActions>
+      </Dialog>
+    </>
+  );
+}
diff --git a/src/component/FileManager/Sidebar/CustomProps/UserPropsContent.tsx b/src/component/FileManager/Sidebar/CustomProps/UserPropsContent.tsx
new file mode 100644
index 0000000..2794901
--- /dev/null
+++ b/src/component/FileManager/Sidebar/CustomProps/UserPropsContent.tsx
@@ -0,0 +1,56 @@
+import { Autocomplete, TextField, Typography } from "@mui/material";
+import { useEffect, useState } from "react";
+import { getSearchUser, getUserInfo } from "../../../../api/api";
+import { User } from "../../../../api/user";
+import { useAppDispatch } from "../../../../redux/hooks";
+import { PropsContentProps } from "./CustomPropsItem";
+
+export default function UserPropsContent({ prop, onChange, loading, readOnly }: PropsContentProps) {
+  const dispatch = useAppDispatch();
+  const [keyword, setKeyword] = useState("");
+  const [users, setUsers] = useState<User[]>([]);
+  const [resolved, setResolved] = useState<User>();
+  useEffect(() => {
+    let active = true;
+    setResolved(undefined);
+    if (prop.value)
+      dispatch(getUserInfo(prop.value))
+        .then((user) => {
+          if (active) setResolved(user);
+        })
+        .catch(() => {});
+    return () => {
+      active = false;
+    };
+  }, [prop.value, dispatch]);
+  useEffect(() => {
+    if (keyword.length < 2) return;
+    let active = true;
+    const timer = window.setTimeout(() => {
+      dispatch(getSearchUser(keyword)).then((result) => {
+        if (active) setUsers(result);
+      });
+    }, 300);
+    return () => {
+      active = false;
+      window.clearTimeout(timer);
+    };
+  }, [keyword, dispatch]);
+  const selected = users.find((user) => user.id === prop.value) ?? (resolved?.id === prop.value ? resolved : undefined);
+  if (readOnly) return <Typography variant="body2">{selected?.nickname ?? prop.value}</Typography>;
+  return (
+    <Autocomplete
+      options={users}
+      filterOptions={(items) => items}
+      disabled={loading}
+      value={selected ?? (prop.value ? ({ id: prop.value, nickname: prop.value } as User) : null)}
+      getOptionLabel={(user) => user.nickname}
+      isOptionEqualToValue={(a, b) => a.id === b.id}
+      onInputChange={(_e, value, reason) => {
+        if (reason === "input") setKeyword(value);
+      }}
+      onChange={(_e, user) => onChange(user?.id ?? "")}
+      renderInput={(params) => <TextField {...params} size="small" placeholder="Search user" />}
+    />
+  );
+}
diff --git a/src/component/Pages/Login/Signin/SSOLoginButtons.tsx b/src/component/Pages/Login/Signin/SSOLoginButtons.tsx
new file mode 100644
index 0000000..b41fc36
--- /dev/null
+++ b/src/component/Pages/Login/Signin/SSOLoginButtons.tsx
@@ -0,0 +1,98 @@
+import { Button, Dialog, DialogActions, DialogContent, DialogTitle, Stack, TextField } from "@mui/material";
+import { useEffect, useRef, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { send2FALogin } from "../../../../api/api";
+import { AppError, Code, send } from "../../../../api/request";
+import { LoginResponse } from "../../../../api/user";
+import { useAppDispatch } from "../../../../redux/hooks";
+import { refreshUserSession } from "../../../../redux/thunks/session";
+
+export default function SSOLoginButtons({ onLoginSuccess }: { onLoginSuccess?: (response: LoginResponse) => void }) {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [providers, setProviders] = useState<any>({});
+  const [session, setSession] = useState("");
+  const [code, setCode] = useState("");
+  const [busy, setBusy] = useState(false);
+  const completed = useRef(false);
+  const success = (response: LoginResponse) =>
+    onLoginSuccess
+      ? onLoginSuccess(response)
+      : dispatch(refreshUserSession(response, new URLSearchParams(window.location.search).get("redirect")));
+  useEffect(() => {
+    dispatch(send("/extensions/public"))
+      .then(setProviders)
+      .catch(() => {});
+    if (new URLSearchParams(window.location.search).get("sso") === "1" && !completed.current) {
+      completed.current = true;
+      const url = new URL(window.location.href);
+      url.searchParams.delete("sso");
+      window.history.replaceState({}, "", url);
+      dispatch(send<LoginResponse>("/sso/complete", { method: "POST" }))
+        .then(success)
+        .catch((error) => {
+          if (error instanceof AppError && error.code === Code.Continue) setSession(error.response.data);
+        });
+    }
+  }, [dispatch]);
+  return (
+    <>
+      <Stack spacing={1}>
+        {["qq", "logto"]
+          .filter((p) => providers[p])
+          .map((provider) => (
+            <Button
+              key={provider}
+              disabled={busy}
+              variant="outlined"
+              onClick={async () => {
+                setBusy(true);
+                try {
+                  const result = await dispatch(
+                    send<{ url: string }>(`/sso/${provider}/start`, {
+                      method: "POST",
+                      data: { return_to: window.location.pathname + window.location.search },
+                    }),
+                  );
+                  window.location.assign(result.url);
+                } finally {
+                  setBusy(false);
+                }
+              }}
+            >
+              {provider === "qq" ? "QQ" : "Logto"} {zh ? "登录" : "sign-in"}
+            </Button>
+          ))}
+      </Stack>
+      <Dialog open={!!session}>
+        <DialogTitle>{zh ? "两步验证" : "Two-factor verification"}</DialogTitle>
+        <DialogContent>
+          <TextField
+            autoFocus
+            label={zh ? "验证码" : "Verification code"}
+            value={code}
+            onChange={(e) => setCode(e.target.value)}
+            inputProps={{ inputMode: "numeric" }}
+          />
+        </DialogContent>
+        <DialogActions>
+          <Button
+            disabled={busy}
+            onClick={async () => {
+              setBusy(true);
+              try {
+                success(await dispatch(send2FALogin({ session_id: session, otp: code })));
+                setSession("");
+              } finally {
+                setBusy(false);
+              }
+            }}
+          >
+            {zh ? "验证" : "Verify"}
+          </Button>
+        </DialogActions>
+      </Dialog>
+    </>
+  );
+}
diff --git a/src/component/Pages/Shares/ShareSales.tsx b/src/component/Pages/Shares/ShareSales.tsx
new file mode 100644
index 0000000..3b1b3b9
--- /dev/null
+++ b/src/component/Pages/Shares/ShareSales.tsx
@@ -0,0 +1,163 @@
+import {
+  Alert,
+  Button,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  Stack,
+  Table,
+  TableBody,
+  TableCell,
+  TableContainer,
+  TableHead,
+  TableRow,
+  Typography,
+} from "@mui/material";
+import { useEffect, useState } from "react";
+import { useTranslation } from "react-i18next";
+import { send } from "../../../api/request";
+import { useAppDispatch } from "../../../redux/hooks";
+
+interface Sale {
+  number: string;
+  share_id: string;
+  buyer_id: string;
+  name: string;
+  amount: number;
+  status: string;
+  provider: string;
+  created_at: string;
+}
+interface Sales {
+  items: Sale[];
+  total: number;
+  paid_orders: number;
+  paid_amount: number;
+}
+
+export default function ShareSales() {
+  const dispatch = useAppDispatch();
+  const { i18n } = useTranslation();
+  const zh = i18n.language.startsWith("zh");
+  const [open, setOpen] = useState(false);
+  const [page, setPage] = useState(1);
+  const [result, setResult] = useState<Sales>();
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [refresh, setRefresh] = useState(0);
+  useEffect(() => {
+    if (!open) return;
+    let active = true;
+    setBusy(true);
+    setError("");
+    dispatch(send<Sales>("/commerce/share-sales", { params: { page, page_size: 20 } }))
+      .then((sales) => {
+        if (active) setResult(sales);
+      })
+      .catch((e) => {
+        if (active) setError(String(e.message ?? e));
+      })
+      .finally(() => {
+        if (active) setBusy(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, [open, page, refresh, dispatch]);
+  const status = (value: string) =>
+    value === "fulfilled"
+      ? zh
+        ? "已付款"
+        : "Paid"
+      : value === "pending"
+        ? zh
+          ? "待付款"
+          : "Pending"
+        : value === "cancelled"
+          ? zh
+            ? "已取消"
+            : "Cancelled"
+          : value;
+  return (
+    <>
+      <Button
+        variant="outlined"
+        sx={{ mb: 2 }}
+        onClick={() => {
+          setPage(1);
+          setOpen(true);
+        }}
+      >
+        {zh ? "收费分享销售订单" : "Paid share sales"}
+      </Button>
+      <Dialog open={open} onClose={() => setOpen(false)} fullWidth maxWidth="lg">
+        <DialogTitle>{zh ? "收费分享销售订单" : "Paid share sales"}</DialogTitle>
+        <DialogContent>
+          <Stack spacing={2}>
+            <Alert severity="info">
+              {zh
+                ? "款项由站点配置的支付商户收取。以下为销售记录，不代表可提现余额；当前不自动分账或退款。"
+                : "The configured site merchant collects payment. These are sales records, not a withdrawable balance. Automatic payouts and refunds are not available."}
+            </Alert>
+            {error && <Alert severity="error">{error}</Alert>}
+            {result && (
+              <Typography>
+                {zh ? "已收款合计" : "Total collected"} ¥{(result.paid_amount / 100).toFixed(2)} · {result.paid_orders}{" "}
+                {zh ? "笔已付款订单" : "paid orders"}
+              </Typography>
+            )}
+            <TableContainer>
+              <Table size="small">
+                <TableHead>
+                  <TableRow>
+                    <TableCell>{zh ? "分享 / 订单号" : "Share / order"}</TableCell>
+                    <TableCell>{zh ? "买家" : "Buyer"}</TableCell>
+                    <TableCell>{zh ? "金额" : "Amount"}</TableCell>
+                    <TableCell>{zh ? "状态" : "Status"}</TableCell>
+                    <TableCell>{zh ? "时间" : "Created"}</TableCell>
+                  </TableRow>
+                </TableHead>
+                <TableBody>
+                  {result?.items.map((sale) => (
+                    <TableRow key={sale.number}>
+                      <TableCell>
+                        <Typography variant="body2">{sale.name}</Typography>
+                        <Typography variant="caption">{sale.number}</Typography>
+                      </TableCell>
+                      <TableCell>{sale.buyer_id}</TableCell>
+                      <TableCell>
+                        ¥{(sale.amount / 100).toFixed(2)}
+                        <Typography variant="caption" display="block">
+                          {sale.provider === "wechat" ? (zh ? "微信支付" : "WeChat Pay") : zh ? "支付宝" : "Alipay"}
+                        </Typography>
+                      </TableCell>
+                      <TableCell>{status(sale.status)}</TableCell>
+                      <TableCell>{new Date(sale.created_at).toLocaleString()}</TableCell>
+                    </TableRow>
+                  ))}
+                </TableBody>
+              </Table>
+            </TableContainer>
+            {result?.total === 0 && (
+              <Typography color="text.secondary">{zh ? "暂无销售订单" : "No sales yet"}</Typography>
+            )}
+          </Stack>
+        </DialogContent>
+        <DialogActions>
+          <Button disabled={busy} onClick={() => setRefresh((value) => value + 1)}>
+            {zh ? "刷新" : "Refresh"}
+          </Button>
+          <Button disabled={busy || page <= 1} onClick={() => setPage((value) => value - 1)}>
+            {zh ? "上一页" : "Previous"}
+          </Button>
+          <Typography>{page}</Typography>
+          <Button disabled={busy || !result || page * 20 >= result.total} onClick={() => setPage((value) => value + 1)}>
+            {zh ? "下一页" : "Next"}
+          </Button>
+          <Button onClick={() => setOpen(false)}>{zh ? "关闭" : "Close"}</Button>
+        </DialogActions>
+      </Dialog>
+    </>
+  );
+}
diff --git a/src/component/Pages/Shop.tsx b/src/component/Pages/Shop.tsx
new file mode 100644
index 0000000..6164502
